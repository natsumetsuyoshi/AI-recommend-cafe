# Google Maps JavaScript API（地図描画用）
# ブラウザに露出するため、Google Cloud 側で HTTP リファラー制限＋API制限を必ず設定すること
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API（周辺カフェ取得用 / サーバー側のみ）
GOOGLE_PLACES_API_KEY=

# Claude API（気分×店舗のマッチング・理由生成 / サーバー側のみ）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# /api/recommend のレート制限（省略時は 10回 / 10分）
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
